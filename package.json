{
  "name": "saiflow",
  "private": true,
  "description": "SaiFlow monorepo — 前端（apps/、packages/，pnpm workspace）+ 后端（services/，Python，独立工具链）",
  "scripts": {
    "dev:web-pc": "pnpm --filter @saiflow/web-pc dev",
