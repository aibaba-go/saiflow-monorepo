# /opt/saiflow/.env on the VPS (mode 600, owner deploy). Names only: real values are
# generated by scripts/vps-bootstrap.sh and never committed.
POSTGRES_USER=
POSTGRES_PASSWORD=
DB_PASSWORD=
# migration account saiflow_v3_migrator (harden-identity); the backend never sees it
DB_MIGRATE_PASSWORD=
APP_HOST=saiflow-app.aibaba.asia
ADMIN_HOST=saiflow-admin.aibaba.asia
LINE_HOST=saiflow-line2.aibaba.asia
IMAGE_TAG=
BACKUP_BUCKET=
# LINE login (B-2a): the LINE MINI App channel of the mini app (LIFF ID tokens)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# comma-separated web-pc callback URLs registered in LINE Developers
LINE_LOGIN_REDIRECT_URIS=
# web-pc's own LINE Login channel in the same provider (a MINI App channel has no callback URL)
LINE_WEB_CHANNEL_ID=
LINE_WEB_CHANNEL_SECRET=
# SMTP for verification codes (B-2a); SMTP_SECURITY is starttls (port 587) or ssl (port 465)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
# Reminders (B-2d): false stops sending; missed reminder days are not sent later
REMINDERS_ENABLED=true
# OCR engines and LLM (B-5b; used by recognition in B-3). Empty = not configured.
TEXTIN_APP_ID=
TEXTIN_SECRET_CODE=
GOOGLE_VISION_API_KEY=
LLM_API_KEY=
# Originals bucket and OCR worker (ocr-scan-flow; docs/deployment/README.md §2.10).
# Empty bucket = uploads answer 503. The key file lives in /opt/saiflow/secrets/ (mode 600).
GCS_BUCKET=
GCS_CREDENTIALS_FILE=/run/secrets/gcs-sa.json
OCR_WORKER_ENABLED=true
# Export download tickets (FR-ENTRY-015): openssl rand -hex 32; empty = tickets answer 503.
DOWNLOAD_TICKET_SECRET=
