# Backend configuration. The app reads ONLY real environment variables;
# this file is a list of names, never put real values in the repo.
# On the VPS these come from /opt/saiflow/.env (mode 600) via Docker Compose; DB_HOST is postgres.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
APP_VERSION=dev

# Integration tests (optional locally, required in CI with REQUIRE_INTEGRATION=1)
TEST_DB_HOST=
TEST_DB_PORT=5432
TEST_DB_NAME=
TEST_DB_USER=
TEST_DB_PASSWORD=

# Optional integrations (unset = the feature answers 503). Real values only in /opt/saiflow/.env.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_LOGIN_REDIRECT_URIS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
